@zombie_servival_3Dgame_Server_HostAddress = https://localhost:7037
@sessionId = replace-with-server-created-session-id

### Username availability is a snapshot, not a reservation. Invalid input returns 400.
GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/register/username-availability?userName=player1

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/live
Accept: application/json

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/health
Accept: application/json
Accept: application/json

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/register/email-code
Content-Type: application/json

{
  "email": "player1@example.com"
}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/register/email-code/verify
Content-Type: application/json

{
  "emailVerificationId": "{{emailVerificationId}}",
  "code": "123456"
}

###

### A 409 code distinguishes username_already_exists from email_already_exists.
### After a username conflict, change userName and reuse the unexpired emailVerificationId.
POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "userName": "player1",
  "email": "player1@example.com",
  "emailVerificationId": "{{emailVerificationId}}",
  "password": "player1-password"
}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "userName": "player1",
  "password": "player1-password"
}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/auth/me
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/player-data/me
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/gacha/pool
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/firearms
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/firearms/Shotgun
Accept: application/json
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/Player/stats/me
Accept: application/json
Authorization: Bearer {{accessToken}}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/Player/stats/upgrades
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
  "statName": "MaxHealth"
}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/gacha/pull
Authorization: Bearer {{accessToken}}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/weapon-upgrades/Shotgun
Authorization: Bearer {{accessToken}}

###

# Start once per game and copy response.sessionId into the sessionId variable.
POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/game-sessions
Authorization: Bearer {{accessToken}}

###

GET {{zombie_servival_3Dgame_Server_HostAddress}}/api/game-sessions/{{sessionId}}
Authorization: Bearer {{accessToken}}

###

# Submit the game result. Retry with this same sessionId and body.
# The server does not verify the truth of these client-reported statistics.
POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/rewards/survival
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "survivalTime": 120.5,
  "clearWave": 3,
  "killZombies": 40
}

###

# Replay: alreadyClaimed=true, no additional gold.
POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/rewards/survival
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "sessionId": "{{sessionId}}",
  "survivalTime": 120.5,
  "clearWave": 3,
  "killZombies": 40
}

###

POST {{zombie_servival_3Dgame_Server_HostAddress}}/api/gacha/pull
Authorization: Bearer {{accessToken}}

###
