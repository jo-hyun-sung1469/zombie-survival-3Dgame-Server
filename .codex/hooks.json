{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/user_prompt_context.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/user_prompt_context.ps1')\"",
            "timeout": 10,
            "statusMessage": "Loading Zombie Survival context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|functions\\.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_guard.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_guard.ps1')\"",
            "timeout": 10,
            "statusMessage": "Checking command and secret safety"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|functions\\.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_guard.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_guard.ps1')\"",
            "timeout": 10,
            "statusMessage": "Reviewing permission request"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|functions\\.shell_command|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/post_tool_audit.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/post_tool_audit.ps1')\"",
            "timeout": 20,
            "statusMessage": "Auditing Zombie Survival changes"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/subagent_stop_audit.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/subagent_stop_audit.ps1')\"",
            "timeout": 10,
            "statusMessage": "Checking subagent handoff quality"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/stop_quality_gate.ps1')\"",
            "commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/stop_quality_gate.ps1')\"",
            "timeout": 30,
            "statusMessage": "Running Zombie Survival quality gate"
          }
        ]
      }
    ]
  }
}
