# 로컬에서는 app.env로 복사하고, Linux 서버에서는 chmod 600 app.env를 적용합니다.
MYSQL_DATABASE=zombie_survival
MYSQL_USER=zombie_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_SSL_MODE=Disabled

JWT_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Zombie Survival

BACKUP_ENABLED=false
MYSQL_BACKUP_S3_URI=
AWS_REGION=
AWS_CREDENTIALS_FILE=/dev/null
AWS_PROFILE=default
ASPNETCORE_ENVIRONMENT=Production
APP_HOST_PORT=5000
APP_SCHEME=https
APP_DOMAIN=zombie-survival-3d-game.duckdns.org
FRONTEND_SUBNET=172.29.0.0/24

# 32자 이상 무작위 값. 영문/숫자/밑줄/하이픈만 사용합니다.
REDIS_PASSWORD=
REDIS_ALERT_WEBHOOK_URL=
# 운영에서는 검증한 image digest로 고정할 수 있습니다.
REDIS_IMAGE=redis:7.4-alpine@sha256:858f009f9709ce576febc734aa78b8f6d624b82571f9ddb6bda4377c833b3499
