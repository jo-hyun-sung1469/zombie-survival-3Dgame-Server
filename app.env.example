# 로컬에서는 app.env로 복사하고, Linux 서버에서는 chmod 600 app.env를 적용합니다.
MYSQL_DATABASE=zombie_survival
MYSQL_USER=zombie_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

JWT_SECRET_KEY=

SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Zombie Survival

BACKUP_ENABLED=false
MYSQL_BACKUP_S3_URI=
AWS_REGION=
ASPNETCORE_ENVIRONMENT=Production
APP_HOST_PORT=5000
